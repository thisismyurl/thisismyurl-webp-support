msgid "Another process is already converting this image."
msgstr "Un autre processus convertit déjà cette image."

msgid "File does not exist."
msgstr "Le fichier n'existe pas."

msgid "Invalid image data."
msgstr "Données d'image invalides."

msgid "Unsupported format."
msgstr "Format non pris en charge."

msgid "WordPress image editor could not load this image."
msgstr "L'éditeur d'images WordPress n'a pas pu charger cette image."

msgid "Failed to create WebP file."
msgstr "Impossible de créer le fichier WebP."

msgid "Failed to create AVIF file."
msgstr "Impossible de créer le fichier AVIF."

msgid "Unable to create backup directory."
msgstr "Impossible de créer le répertoire de sauvegarde."

msgid "Failed to archive original file."
msgstr "Impossible d'archiver le fichier original."

msgid "AVIF output requested but Imagick is missing AVIF support on this server."
msgstr "La sortie AVIF est demandée, mais Imagick ne prend pas en charge AVIF sur ce serveur."

msgid "Image could not be restored."
msgstr "Impossible de restaurer l'image."

msgid "Unauthorized request."
msgstr "Demande non autorisée."

msgid "Invalid attachment ID."
msgstr "Identifiant de pièce jointe invalide."

msgid "Unknown error."
msgstr "Erreur inconnue."

msgid "No attachments were provided for batch processing."
msgstr "Aucune pièce jointe fournie pour le traitement par lot."

msgid "Unknown conversion error."
msgstr "Erreur de conversion inconnue."

msgid "You do not have permission to access this page."
msgstr "Vous n'avez pas la permission d'accéder à cette page."

msgid "Settings"
msgstr "Paramètres"

msgid "Donate"
msgstr "Faire un don"

msgid "WebP Support"
msgstr "Support WebP"

#. translators: %s is a linked site name
msgid "by %s"
msgstr "par %s"

msgid "Non-destructive WebP/AVIF conversion with backups and one-click restoration."
msgstr "Conversion WebP/AVIF non destructive avec sauvegardes et restauration en un clic."

msgid "Optimization Dashboard"
msgstr "Tableau de bord d'optimisation"

#. translators: %d is the number of images
msgid "Optimize All %d Images"
msgstr "Optimiser les %d images"

msgid "Cancel Batch"
msgstr "Annuler le lot"

msgid "Conversion Settings"
msgstr "Paramètres de conversion"

msgid "Output Format"
msgstr "Format de sortie"

msgid "WebP (recommended)"
msgstr "WebP (recommandé)"

msgid "AVIF (Imagick only)"
msgstr "AVIF (Imagick uniquement)"

msgid "Both — AVIF primary + WebP companion via &lt;picture&gt;"
msgstr "Les deux — AVIF principal + WebP complémentaire via &lt;picture&gt;"

msgid "AVIF unavailable: Imagick not installed or missing libheif"
msgstr "AVIF non disponible : Imagick non installé ou libheif manquant"

msgid "Quality Preset"
msgstr "Préréglage de qualité"

msgid "Web (82) — balanced size/quality"
msgstr "Web (82) — équilibre taille/qualité"

msgid "Print (95) — high fidelity"
msgstr "Impression (95) — haute fidélité"

msgid "Lossless (100)"
msgstr "Sans perte (100)"

msgid "Custom"
msgstr "Personnalisé"

msgid "Custom quality (0–100):"
msgstr "Qualité personnalisée (0–100) :"

msgid "Batch Size"
msgstr "Taille du lot"

msgid "Number of images processed per AJAX request."
msgstr "Nombre d'images traitées par requête AJAX."

msgid "Enable Conversion For"
msgstr "Activer la conversion pour"

msgid "Only enabled formats will appear in Pending Optimizations."
msgstr "Seuls les formats activés apparaîtront dans les optimisations en attente."

msgid "Uninstall Behavior"
msgstr "Comportement à la désinstallation"

msgid "Delete backup files when plugin is uninstalled."
msgstr "Supprimer les fichiers de sauvegarde lors de la désinstallation du plugiciel."

msgid "Save Settings"
msgstr "Enregistrer les paramètres"

#. translators: 1: number of files, 2: total size formatted
msgid "Pending: %1$d file(s), %2$s total."
msgstr "En attente : %1$d fichier(s), %2$s au total."

#. translators: 1: savings size formatted, 2: image count
msgid "Saved: %1$s across %2$d image(s)."
msgstr "Économisé : %1$s pour %2$d image(s)."

msgid "Pending Optimizations"
msgstr "Optimisations en attente"

msgid "Preview"
msgstr "Aperçu"

msgid "ID"
msgstr "ID"

msgid "File Name"
msgstr "Nom du fichier"

msgid "Size"
msgstr "Taille"

msgid "All images optimized!"
msgstr "Toutes les images sont optimisées !"

msgid "Managed Media"
msgstr "Médias gérés"

msgid "Saved"
msgstr "Économisé"

msgid "Action"
msgstr "Action"

msgid "File Missing"
msgstr "Fichier manquant"

msgid "Excluded by Settings"
msgstr "Exclu par les paramètres"

msgid "Restore"
msgstr "Restaurer"

msgid "Optimized"
msgstr "Optimisé"

msgid "Documentation"
msgstr "Documentation"

msgid "This plugin converts JPEG, PNG, GIF, and BMP images into WebP or AVIF using the WordPress image editor stack (GD or Imagick). Originals are moved to a backup directory and can be restored any time."
msgstr "Ce plugiciel convertit les images JPEG, PNG, GIF et BMP en WebP ou AVIF à l'aide de la pile d'édition d'images de WordPress (GD ou Imagick). Les originaux sont déplacés vers un répertoire de sauvegarde et peuvent être restaurés à tout moment."

msgid "Bulk Actions"
msgstr "Actions groupées"

msgid "Restore All Originals"
msgstr "Restaurer tous les originaux"

#. translators: %s is a linked site name
msgid "Provided free by %s."
msgstr "Fourni gratuitement par %s."

msgid "Donate to Development"
msgstr "Contribuer au développement"

msgid "Processing..."
msgstr "Traitement en cours…"

msgid "Restoring..."
msgstr "Restauration en cours…"

msgid "Restore all images? This cannot be undone."
msgstr "Restaurer toutes les images ? Cette action est irréversible."

msgid "Some images failed:"
msgstr "Certaines images ont échoué :"
